# Copy to .env and fill in real values. .env is git-ignored.

# Port the Express server listens on
PORT=3000

# JWT signing secret (generate a long random string, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef 

# Access token lifetime (default 15m)
JWT_ACCESS_TTL=15m

# Default values used by `npm run seed` when creating the first SUPER_ADMIN
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-password

# Google service account key path (git-ignored) — used in Phase 6
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Digest job — used in Phase 6
DIGEST_CRON=0 6 * * *
DIGEST_RECIPIENT_EMAIL=admin@example.com
