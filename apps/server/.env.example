# Copy to .env and fill in real values. .env is git-ignored.

# Port the Express server listens on
PORT=3000

# JWT signing secret (generate a long random string, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef

# Access token lifetime (default 15m)
JWT_ACCESS_TTL=15m

# Default values used by `npm run seed` when creating the first SUPER_ADMIN
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-password

# Outbound email for "new issue" notifications.
# off  = email disabled (default; the app runs fine with no credentials)
# smtp = send through the SMTP server below
MAIL_DRIVER=off
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Required when MAIL_DRIVER=smtp; falls back to SMTP_USER when omitted.
# Use the no-reply mailbox, e.g. no-reply@yourcompany.com
MAIL_FROM=
MAIL_FROM_NAME=Project Tracker
# Optional: base URL used to build email links, e.g. http://192.168.1.10:5173
# (the email links to /grid?project=<id> so the grid highlights that project).
APP_BASE_URL=
